# 复制本文件为 .env，再填写服务商提供的值。
# .env 已被 .gitignore 排除，绝不能把真实密钥提交到GitHub。

LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://provider.example.com/v1
LLM_MODEL=your_model_name_here

# 部分兼容服务不支持 response_format，请保持 false。
# 确认服务商支持JSON mode后再改为 true。
LLM_JSON_MODE=false

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=3000
