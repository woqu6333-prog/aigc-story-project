# 复制本文件为 .env，再填写服务商提供的值。
# .env 已被 .gitignore 排除，绝不能把真实密钥提交到GitHub。

# 推荐：Google AI Studio 当前提供免费额度。只填这一项即可，
# 程序会自动使用官方OpenAI兼容地址与gemini-3.8-flash。
GEMINI_API_KEY=

# 也支持任意OpenAI兼容服务；使用Gemini时以下三项可留空。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# 部分兼容服务不支持 response_format，请保持 false。
# 确认服务商支持JSON mode后再改为 true。
LLM_JSON_MODE=false

LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=3000

# 可选：本地MiniMax H3网页生成。默认值已匹配当前电脑，可按实际安装位置修改。
H3_COMFYUI_URL=http://127.0.0.1:8188
H3_WORKFLOW_PATH=D:\Comfy-Desktop\ComfyUI-Installs\ComfyUI (1)\ComfyUI\user\default\workflows\video_minimax_h3_r2v.json
